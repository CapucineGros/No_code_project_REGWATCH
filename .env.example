# Database
POSTGRES_USER=regwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=regwatch

# Pinned n8n version (check the n8n releases page before changing it)
N8N_VERSION=2.41.4

# Encrypts the credentials stored by n8n. Generate one with: openssl rand -hex 32
# Keep the same key forever, otherwise stored credentials become unreadable.
N8N_ENCRYPTION_KEY=change-me-with-a-long-random-string

# Public HTTPS URL that Telegram can reach (ngrok or cloudflared tunnel for local use)
WEBHOOK_URL=https://your-tunnel-url.example/