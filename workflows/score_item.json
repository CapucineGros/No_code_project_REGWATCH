    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse the LLM JSON answer and keep the original item fields\nconst raw = ($json.text || '').replace(/```json|```/g, '').trim();\nlet r;\ntry {\n  r = JSON.parse(raw);\n} catch (e) {\n  r = { score: 0, matched_topic: 'none', summary: '' };\n}\n\nconst score = Number(r && r.score);\nconst valid = r !== null && typeof r === 'object' && Number.isFinite(score) && score >= 0 && score <= 10;\n\nconst input = $('When Executed by Another Workflow').item.json;\n\nreturn {\n  json: {\n    ...input,\n    score: valid ? score : 0,\n    matched_topic: valid ? String(r.matched_topic || 'none') : 'none',\n    summary: valid ? String(r.summary || '') : '',\n    ai_valid: valid\n  }\n};"
      },
