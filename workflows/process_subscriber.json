    {
      "parameters": {
        "jsCode": "// Read the subscriber passed in by the parent workflow\nconst chatId = String($('When Executed by Another Workflow').first().json.chat_id);\nconst norm = s => String(s || '').trim().toLowerCase();\nconst topics = $('When Executed by Another Workflow').first().json.topics;\n\nconst sent = $('Get Sent').all()\n  .filter(r => String(r.json.chat_id) === chatId);\nconst sentLinks = new Set(sent.map(r => norm(r.json.link)));\nconst sentTitles = new Set(sent.map(r => norm(r.json.title)).filter(t => t));\n\nconst seenTitles = new Set();\nconst out = [];\nfor (const i of $('RSS Read').all()) {\n  const link = norm(i.json.link);\n  const title = norm(i.json.title);\n  // Skip if already sent, or duplicated inside this same feed\n  if (!link || sentLinks.has(link) || sentTitles.has(title) || seenTitles.has(title)) continue;\n  seenTitles.add(title);\n  out.push({\n    json: { chat_id: chatId, topics, title: i.json.title, link: i.json.link, date: i.json.pubDate }\n  });\n}\n\n// Limit AI calls (free tier quota)\nreturn out.slice(0, 3);"
      },
