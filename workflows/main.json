        "parameters": {
          "jsCode": "// Parse \"/topics liquidity, IRRBB\" into a clean list of topics\nconst text = $json.message.text;\nconst chatId = $json.message.chat.id;\n\nconst topics = text\n  .replace('/topics', '')\n  .split(',')\n  .map(t => t.trim().toLowerCase())\n  .filter(t => t.length > 0);\n\nreturn {\n  json: {\n    chat_id: chatId,\n    topics: topics,\n    topics_text: topics.join(', '),\n    valid: topics.length > 0\n  }\n};"
        },
